# Generated by zona-install — single zona-p2p node.
networks:
  zona-net:
    driver: bridge

services:
  node:
    build:
      context: .
      dockerfile: Dockerfile
    image: {{.Image}}
{{ if .ComposePlatform }}    platform: {{.ComposePlatform}}
{{ end }}
    networks:
      - zona-net
    ports:
      - "{{.HostPort}}:7701"
    environment:
      ZONA_NODE_SEED: '{{.NodeSeedHex}}'
      ZONA_ADMIN_URL: 'http://node:7701'
      ZONA_ADMIN_PORT: '7701'
      RUST_LOG: 'info'
    restart: unless-stopped
